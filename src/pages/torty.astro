---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Konfigurator tortów" page="torty">

<section class="konfig-hero">
  <h1>Zaprojektuj swój tort</h1>
  <p>Skonfiguruj wymarzony tort — zobaczymy go razem przed zamówieniem.</p>
</section>

<section class="konfig">
  <div class="konfig-options">

    <div class="konfig-block">
      <div class="konfig-num">01</div>
      <h3>Liczba pięter</h3>
      <div class="tier-grid">
        <button class="tier-btn active" data-key="tiers" data-value="1">
          <svg viewBox="0 0 60 50" fill="none"><rect x="10" y="15" width="40" height="22" rx="4" fill="#A3320B" opacity=".2" stroke="#A3320B" stroke-width="2"/><ellipse cx="30" cy="15" rx="20" ry="5" fill="#A3320B" opacity=".35"/><ellipse cx="30" cy="37" rx="20" ry="5" fill="#A3320B" opacity=".25"/></svg>
          <span>1 piętro</span>
        </button>
        <button class="tier-btn" data-key="tiers" data-value="2">
          <svg viewBox="0 0 60 60" fill="none"><rect x="8" y="32" width="44" height="20" rx="4" fill="#A3320B" opacity=".2" stroke="#A3320B" stroke-width="2"/><rect x="16" y="14" width="28" height="20" rx="4" fill="#A3320B" opacity=".2" stroke="#A3320B" stroke-width="2"/><ellipse cx="30" cy="14" rx="14" ry="4" fill="#A3320B" opacity=".35"/><ellipse cx="30" cy="52" rx="22" ry="5" fill="#A3320B" opacity=".25"/></svg>
          <span>2 piętra</span>
        </button>
        <button class="tier-btn" data-key="tiers" data-value="3">
          <svg viewBox="0 0 60 70" fill="none"><rect x="5" y="46" width="50" height="18" rx="4" fill="#A3320B" opacity=".2" stroke="#A3320B" stroke-width="2"/><rect x="13" y="28" width="34" height="18" rx="4" fill="#A3320B" opacity=".2" stroke="#A3320B" stroke-width="2"/><rect x="20" y="12" width="20" height="18" rx="4" fill="#A3320B" opacity=".2" stroke="#A3320B" stroke-width="2"/><ellipse cx="30" cy="12" rx="10" ry="3.5" fill="#A3320B" opacity=".4"/><ellipse cx="30" cy="64" rx="25" ry="5.5" fill="#A3320B" opacity=".2"/></svg>
          <span>3 piętra</span>
        </button>
      </div>
    </div>

    <div class="konfig-block">
      <div class="konfig-num">02</div>
      <h3>Liczba porcji</h3>
      <div class="slice-grid">
        {[6, 8, 10, 12, 16, 20].map(n => (
          <button class:list={['slice-btn', { active: n === 8 }]} data-key="slices" data-value={n}>
            {n}
          </button>
        ))}
      </div>
    </div>

    <div class="konfig-block">
      <div class="konfig-num">03</div>
      <h3>Smak biszkoptu</h3>
      <div class="flavor-grid">
        {[
          { v: 'waniliowy', label: 'Waniliowy', dot: '#f5e67a' },
          { v: 'czekoladowy', label: 'Czekoladowy', dot: '#7a3a10' },
          { v: 'cytrynowy', label: 'Cytrynowy', dot: '#e8f048' },
          { v: 'marchewkowy', label: 'Marchewkowy', dot: '#e87820' },
        ].map(f => (
          <button class:list={['flavor-btn', { active: f.v === 'waniliowy' }]} data-key="biszkopt" data-value={f.v}>
            <span class="flavor-dot" style={`background: ${f.dot}`}></span>
            {f.label}
          </button>
        ))}
      </div>
    </div>

    <div class="konfig-block">
      <div class="konfig-num">04</div>
      <h3>Rodzaj kremu</h3>
      <div class="flavor-grid">
        {[
          { v: 'smietankowy', label: 'Śmietankowy' },
          { v: 'maslany', label: 'Maślany' },
          { v: 'sernikowy', label: 'Sernikowy' },
          { v: 'ganache', label: 'Ganache' },
        ].map(k => (
          <button class:list={['flavor-btn', { active: k.v === 'smietankowy' }]} data-key="krem" data-value={k.v}>
            {k.label}
          </button>
        ))}
      </div>
    </div>

    <div class="konfig-block">
      <div class="konfig-num">05</div>
      <h3>Kolor polewy</h3>
      <div class="color-grid">
        {[
          { v: 'bialy',       color: '#f8f2ea', label: 'Biały' },
          { v: 'rozowy',      color: '#fbbdd0', label: 'Różowy' },
          { v: 'niebieski',   color: '#a8c8f0', label: 'Niebieski' },
          { v: 'czekoladowy', color: '#8B4513', label: 'Czekoladowy' },
          { v: 'kremowy',     color: '#f5e2b8', label: 'Kremowy' },
        ].map(c => (
          <button class:list={['color-btn', { active: c.v === 'bialy' }]} data-key="polewa" data-value={c.v} title={c.label}>
            <span class="color-swatch" style={`background: ${c.color}`}></span>
            <span class="color-label">{c.label}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="konfig-block">
      <div class="konfig-num">06</div>
      <h3>Dekoracje</h3>
      <p class="konfig-hint">Możesz wybrać kilka.</p>
      <div class="deko-grid">
        {[
          { v: 'owoce',   label: 'Owoce świeże', extra: '+15 zł' },
          { v: 'kwiaty',  label: 'Kwiaty jadalne', extra: '+15 zł' },
          { v: 'posypki', label: 'Kolorowe posypki', extra: '+8 zł' },
          { v: 'figurka', label: 'Figurka na tort', extra: '+25 zł' },
        ].map(d => (
          <button class="deko-btn" data-key="deko" data-value={d.v}>
            <span class="deko-label">{d.label}</span>
            <span class="deko-extra">{d.extra}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="konfig-block">
      <div class="konfig-num">07</div>
      <h3>Napis na torcie</h3>
      <p class="konfig-hint">Opcjonalnie — max. 20 znaków.</p>
      <input
        type="text"
        id="napísInput"
        class="napis-input"
        placeholder="np. Wszystkiego najlepszego!"
        maxlength="20"
      />
    </div>

  </div>

  <div class="konfig-preview">
    <div class="preview-card">
      <svg id="cakeSvg" viewBox="0 0 320 400" xmlns="http://www.w3.org/2000/svg" aria-label="Podgląd tortu"></svg>
    </div>

    <div class="summary-card">
      <h3>Twój tort</h3>
      <ul id="summaryList" class="summary-list"></ul>
      <div class="summary-price">
        Szacunkowa cena: <strong id="priceDisplay">—</strong>
      </div>
      <a href={`${import.meta.env.BASE_URL}/kontakt`} class="btn-orange" id="orderBtn">Zamów ten tort</a>
    </div>
  </div>
</section>

</Layout>

<style>
.konfig-hero {
  background: var(--yellow);
  text-align: center;
  padding: 3.5rem 2rem 2rem;
}
.konfig-hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  text-transform: uppercase;
  color: var(--crimson);
}
.konfig-hero p {
  margin-top: 0.6rem;
  font-size: 1rem;
  opacity: 0.7;
}

.konfig {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 2rem 5rem;
  align-items: start;
}

.konfig-options {
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
}

.konfig-block {
  background: white;
  border-radius: 20px;
  border: 2px solid rgba(107,5,4,0.1);
  padding: 1.6rem 1.8rem;
}
.konfig-block h3 {
  font-family: 'DM Sans', sans-serif;
  font-weight: 700;
  font-size: 1rem;
  color: var(--text);
  margin-bottom: 1rem;
}
.konfig-num {
  font-family: 'Abril Fatface', serif;
  font-size: 2.2rem;
  color: var(--blue);
  opacity: 0.18;
  line-height: 1;
  margin-bottom: 0.3rem;
}
.konfig-hint {
  font-size: 0.8rem;
  opacity: 0.55;
  margin: -0.5rem 0 0.8rem;
}

/* TIER BUTTONS */
.tier-grid {
  display: flex;
  gap: 1rem;
}
.tier-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 0.5rem;
  border: 2px solid rgba(107,5,4,0.2);
  border-radius: 16px;
  background: var(--yellow);
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text);
}
.tier-btn svg { width: 52px; height: auto; }
.tier-btn:hover { border-color: var(--blue); }
.tier-btn.active {
  border-color: var(--blue);
  background: rgba(107,5,4,0.07);
  color: var(--blue);
}

/* SLICE BUTTONS */
.slice-grid {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.slice-btn {
  min-width: 52px;
  padding: 0.6rem 0.8rem;
  border: 2px solid rgba(107,5,4,0.18);
  border-radius: 12px;
  background: var(--yellow);
  font-family: 'DM Sans', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.slice-btn:hover { border-color: var(--blue); }
.slice-btn.active {
  border-color: var(--blue);
  background: var(--blue);
  color: white;
}

/* FLAVOR BUTTONS */
.flavor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
}
.flavor-btn {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.65rem 1rem;
  border: 2px solid rgba(107,5,4,0.15);
  border-radius: 12px;
  background: var(--yellow);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text);
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}
.flavor-btn:hover { border-color: var(--blue); }
.flavor-btn.active {
  border-color: var(--blue);
  background: rgba(107,5,4,0.07);
  font-weight: 700;
  color: var(--blue);
}
.flavor-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1px solid rgba(0,0,0,0.1);
}

/* COLOR SWATCHES */
.color-grid {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.color-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem;
  border: 2px solid transparent;
  border-radius: 12px;
  background: transparent;
  cursor: pointer;
  transition: border-color 0.15s;
}
.color-btn:hover { border-color: rgba(107,5,4,0.4); }
.color-btn.active { border-color: var(--blue); }
.color-swatch {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid rgba(0,0,0,0.1);
  display: block;
}
.color-label {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
}

/* DEKO BUTTONS */
.deko-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
}
.deko-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0.8rem 1rem;
  border: 2px solid rgba(107,5,4,0.15);
  border-radius: 12px;
  background: var(--yellow);
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
  text-align: left;
  font-family: 'DM Sans', sans-serif;
}
.deko-btn:hover { border-color: var(--orange); }
.deko-btn.active {
  border-color: var(--orange);
  background: rgba(230,175,46,0.06);
}
.deko-label {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text);
}
.deko-extra {
  font-size: 0.75rem;
  color: var(--crimson);
  font-weight: 600;
  margin-top: 0.2rem;
}

/* NAPIS */
.napis-input {
  width: 100%;
  border: none;
  border-bottom: 2px solid var(--orange);
  background: transparent;
  padding: 0.55rem 0;
  font-size: 1rem;
  font-family: 'DM Sans', sans-serif;
  color: var(--text);
  outline: none;
}
.napis-input:focus { border-bottom-color: var(--blue); }

/* PREVIEW COLUMN */
.konfig-preview {
  position: sticky;
  top: 84px;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}
.preview-card {
  background: var(--blue);
  border-radius: 24px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
#cakeSvg {
  width: 100%;
  max-width: 280px;
  height: auto;
  display: block;
  margin: 0 auto;
}
.summary-card {
  background: white;
  border-radius: 20px;
  border: 2px solid rgba(107,5,4,0.12);
  padding: 1.5rem;
}
.summary-card h3 {
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--blue);
  margin-bottom: 1rem;
}
.summary-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 1.2rem;
}
.summary-list li {
  font-size: 0.88rem;
  color: var(--text);
  display: flex;
  justify-content: space-between;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(107,5,4,0.08);
}
.summary-list li span { color: var(--blue); font-weight: 600; }
.summary-price {
  font-size: 0.95rem;
  color: var(--text);
  margin-bottom: 1.2rem;
}
.summary-price strong {
  font-size: 1.3rem;
  color: var(--blue);
  font-family: 'Abril Fatface', serif;
}

@media (max-width: 900px) {
  .konfig {
    grid-template-columns: 1fr;
  }
  .konfig-preview {
    position: static;
    order: -1;
  }
}
@media (max-width: 500px) {
  .flavor-grid, .deko-grid { grid-template-columns: 1fr; }
  .tier-grid { gap: 0.5rem; }
}
</style>

<script>
const FROSTING: Record<string, { fill: string; top: string; shadow: string; stroke: string }> = {
  bialy:       { fill: '#f8f2ea', top: '#ede4d4', shadow: '#d5c8b5', stroke: '#b0a090' },
  rozowy:      { fill: '#fbbdd0', top: '#f09ab5', shadow: '#dc7898', stroke: '#b05575' },
  niebieski:   { fill: '#b0cff5', top: '#8aaedd', shadow: '#6888c0', stroke: '#4a6aa0' },
  czekoladowy: { fill: '#9a5530', top: '#703a18', shadow: '#4a2208', stroke: '#300e00' },
  kremowy:     { fill: '#f5e2b8', top: '#dfc890', shadow: '#c0a060', stroke: '#907840' },
};

const TIER_DEFS = [
  { w: 240, h: 88 },
  { w: 168, h: 78 },
  { w: 108, h: 68 },
];

interface Config {
  tiers: number;
  slices: number;
  biszkopt: string;
  krem: string;
  polewa: string;
  deko: string[];
  napis: string;
}

let config: Config = {
  tiers: 1,
  slices: 8,
  biszkopt: 'waniliowy',
  krem: 'smietankowy',
  polewa: 'bialy',
  deko: [],
  napis: '',
};

function buildSvg(cfg: Config): string {
  const CX = 160;
  const PLATE_Y = 348;
  const ERY = 13;
  const color = FROSTING[cfg.polewa] ?? FROSTING.bialy;
  const activeTiers = TIER_DEFS.slice(0, cfg.tiers);

  let s = '';

  // Build tier positions bottom→top
  let yPos = PLATE_Y;
  const tiers: Array<{ w: number; h: number; y: number }> = [];
  for (const t of activeTiers) {
    yPos -= t.h;
    tiers.push({ ...t, y: yPos });
  }

  const bottom = tiers[0];
  const top = tiers[tiers.length - 1];

  // Plate
  s += `<ellipse cx="${CX}" cy="${PLATE_Y + 10}" rx="158" ry="17" fill="#d8cfc0"/>`;
  s += `<ellipse cx="${CX}" cy="${PLATE_Y + 8}" rx="155" ry="15" fill="#ede5d8"/>`;

  // Tiers + slice lines drawn on top ellipse of each tier
  const sliceAngle = (2 * Math.PI) / cfg.slices;
  for (let i = 0; i < tiers.length; i++) {
    const { w, h, y } = tiers[i];
    const rx = w / 2;
    const x = CX - rx;

    s += `<ellipse cx="${CX}" cy="${y + h}" rx="${rx}" ry="${ERY}" fill="${color.shadow}"/>`;
    s += `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${color.fill}"/>`;
    s += `<rect x="${x}" y="${y}" width="7" height="${h}" fill="${color.shadow}" opacity="0.35"/>`;
    s += `<rect x="${x + w - 7}" y="${y}" width="7" height="${h}" fill="${color.shadow}" opacity="0.35"/>`;
    s += `<rect x="${x}" y="${y + h - 8}" width="${w}" height="8" fill="${color.top}" opacity="0.55"/>`;
    s += `<ellipse cx="${CX}" cy="${y}" rx="${rx}" ry="${ERY}" fill="${color.top}"/>`;
    // All slice lines on top ellipse — proper ellipse projection, no cap
    for (let sl = 0; sl < cfg.slices; sl++) {
      const angle = sl * sliceAngle - Math.PI / 2;
      const ex = CX + Math.cos(angle) * rx;
      const ey = y + Math.sin(angle) * ERY;
      s += `<line x1="${CX}" y1="${y}" x2="${ex}" y2="${ey}" stroke="${color.stroke}" stroke-width="1" opacity="0.35"/>`;
    }
  }

  // Frosting drips on top tier
  const drips = Math.floor((top.w - 40) / 32);
  for (let d = 0; d < drips; d++) {
    const dx = CX - top.w / 2 + 20 + d * ((top.w - 40) / Math.max(drips - 1, 1));
    const dl = 9 + [0, 8, 5][d % 3];
    s += `<rect x="${dx - 4}" y="${top.y - ERY + 5}" width="8" height="${dl}" rx="4" fill="${color.top}"/>`;
  }

  // Posypki — scattered on tier bodies (side faces)
  if (cfg.deko.includes('posypki')) {
    const cols = ['#e03030', '#3060e0', '#30a030', '#e0a030', '#9030c0', '#20c0c0'];
    let seed = 1337;
    const rnd = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };
    tiers.forEach(({ w, h, y }) => {
      for (let i = 0; i < 14; i++) {
        const sx = CX - w / 2 + 10 + rnd() * (w - 20);
        const sy = y + 8 + rnd() * (h - 14);
        const ang = rnd() * 180;
        const col = cols[Math.floor(rnd() * cols.length)];
        s += `<rect x="${sx}" y="${sy}" width="9" height="3.5" rx="1.75" fill="${col}" transform="rotate(${ang} ${sx} ${sy})"/>`;
      }
    });
  }

  // Owoce — on FRONT FACE of bottom tier (body area, below mid-height)
  // Placed within the tier body, never conflicts with candles above the tier
  if (cfg.deko.includes('owoce')) {
    const bw = bottom.w;
    const fy = bottom.y + bottom.h * 0.58;
    [CX - bw * 0.3, CX - bw * 0.1, CX + bw * 0.1, CX + bw * 0.3].forEach(fx => {
      s += `<ellipse cx="${fx}" cy="${fy + 6}" rx="7" ry="9" fill="#d42020"/>`;
      s += `<ellipse cx="${fx - 2}" cy="${fy}" rx="3" ry="3.5" fill="#bb1010"/>`;
      s += `<line x1="${fx}" y1="${fy - 4}" x2="${fx}" y2="${fy - 12}" stroke="#2a8a2a" stroke-width="2" stroke-linecap="round"/>`;
      s += `<ellipse cx="${fx + 4}" cy="${fy - 10}" rx="4" ry="2.5" fill="#2a8a2a" transform="rotate(-30 ${fx + 4} ${fy - 10})"/>`;
    });
  }

  // Kwiaty — on FRONT FACE of bottom tier (upper portion of body)
  // Placed within the tier body, never conflicts with candles above the tier
  if (cfg.deko.includes('kwiaty')) {
    const bw = bottom.w;
    const ky = bottom.y + bottom.h * 0.28;
    [
      { x: CX - bw * 0.33, y: ky,     c: '#f9b0d0' },
      { x: CX,              y: ky - 5, c: '#f9d070' },
      { x: CX + bw * 0.33, y: ky,     c: '#c0a0f0' },
    ].forEach(({ x, y, c }) => {
      for (let p = 0; p < 5; p++) {
        const a = (p / 5) * Math.PI * 2 - Math.PI / 2;
        s += `<ellipse cx="${x + Math.cos(a) * 6}" cy="${y + Math.sin(a) * 6}" rx="5" ry="5" fill="${c}"/>`;
      }
      s += `<circle cx="${x}" cy="${y}" r="4" fill="#f8e040"/>`;
    });
  }

  // Napis — on bottom tier front face; dynamic font-size + textLength to fit all 20 chars
  if (cfg.napis) {
    const availW = bottom.w - 24;
    const estimatedW = cfg.napis.length * 8;
    const tl = Math.min(availW, estimatedW);
    const ty = bottom.y + bottom.h / 2 + 5;
    s += `<text x="${CX}" y="${ty}" text-anchor="middle" font-family="Georgia, serif" font-size="13" font-style="italic" fill="${color.stroke}" textLength="${tl}" lengthAdjust="spacingAndGlyphs">${cfg.napis}</text>`;
  }

  // Figurka — on top tier, shifted LEFT of center so candles (center-right) don't overlap
  if (cfg.deko.includes('figurka')) {
    const offset = top.w * 0.3;
    const fx = CX - offset;
    const fy = top.y - ERY - 18;
    const pts: string[] = [];
    for (let p = 0; p < 10; p++) {
      const a = (p / 10) * Math.PI * 2 - Math.PI / 2;
      const r = p % 2 === 0 ? 14 : 6;
      pts.push(`${fx + Math.cos(a) * r},${fy + Math.sin(a) * r}`);
    }
    s += `<polygon points="${pts.join(' ')}" fill="#f0c020" stroke="#d0a010" stroke-width="1.5"/>`;
  }

  // Candles — on top tier, CENTER-RIGHT area, drawn LAST (always on top of everything)
  const candleCount = cfg.tiers;
  const spacing = 28;
  const hasFiguarka = cfg.deko.includes('figurka');
  const candleBase = hasFiguarka ? CX + top.w * 0.1 : CX;
  const cx0 = candleBase - ((candleCount - 1) * spacing) / 2;
  const candleColors = ['#f0d060', '#f08060', '#80c0f0', '#d0a0f0'];
  for (let c = 0; c < candleCount; c++) {
    const cx = cx0 + c * spacing;
    const cy = top.y - ERY - 2;
    s += `<rect x="${cx - 4}" y="${cy - 28}" width="8" height="26" rx="4" fill="${candleColors[c % 4]}"/>`;
    s += `<ellipse cx="${cx}" cy="${cy - 33}" rx="4.5" ry="6.5" fill="#ff7820" opacity="0.88"/>`;
    s += `<ellipse cx="${cx}" cy="${cy - 37}" rx="2.5" ry="4" fill="#fff870" opacity="0.95"/>`;
  }

  return s;
}

const LABELS: Record<string, Record<string, string>> = {
  biszkopt: { waniliowy: 'Waniliowy', czekoladowy: 'Czekoladowy', cytrynowy: 'Cytrynowy', marchewkowy: 'Marchewkowy' },
  krem: { smietankowy: 'Śmietankowy', maslany: 'Maślany', sernikowy: 'Sernikowy', ganache: 'Ganache' },
  polewa: { bialy: 'Biały', rozowy: 'Różowy', niebieski: 'Niebieski', czekoladowy: 'Czekoladowy', kremowy: 'Kremowy' },
};

const DEKO_PRICES: Record<string, number> = { owoce: 15, kwiaty: 15, posypki: 8, figurka: 25 };

function calcPrice(cfg: Config): number {
  const base = [0, 80, 140, 200][cfg.tiers];
  const sliceMult = cfg.slices <= 8 ? 1 : cfg.slices <= 12 ? 1.1 : cfg.slices <= 16 ? 1.15 : 1.2;
  const biszkoptAdd = { waniliowy: 0, cytrynowy: 10, marchewkowy: 10, czekoladowy: 15 }[cfg.biszkopt] ?? 0;
  const kremAdd = { smietankowy: 0, maslany: 10, sernikowy: 15, ganache: 20 }[cfg.krem] ?? 0;
  const dekoAdd = cfg.deko.reduce((sum, d) => sum + (DEKO_PRICES[d] ?? 0), 0);
  const napisAdd = cfg.napis ? 15 : 0;
  return Math.round(base * sliceMult + biszkoptAdd + kremAdd + dekoAdd + napisAdd);
}

function refresh() {
  const svg = document.getElementById('cakeSvg');
  if (svg) svg.innerHTML = buildSvg(config);

  const price = calcPrice(config);
  const priceEl = document.getElementById('priceDisplay');
  if (priceEl) priceEl.textContent = `${price} zł`;

  const dekoNames = config.deko.map(d => ({ owoce: 'Owoce', kwiaty: 'Kwiaty', posypki: 'Posypki', figurka: 'Figurka' }[d] ?? d));
  const rows: Array<[string, string]> = [
    ['Piętra', `${config.tiers}`],
    ['Porcje', `${config.slices}`],
    ['Biszkopt', LABELS.biszkopt[config.biszkopt] ?? config.biszkopt],
    ['Krem', LABELS.krem[config.krem] ?? config.krem],
    ['Polewa', LABELS.polewa[config.polewa] ?? config.polewa],
    ...(dekoNames.length ? [['Dekoracje', dekoNames.join(', ')] as [string,string]] : []),
    ...(config.napis ? [['Napis', `"${config.napis}"`] as [string,string]] : []),
  ];

  const list = document.getElementById('summaryList');
  if (list) {
    list.innerHTML = rows.map(([k, v]) => `<li>${k}<span>${v}</span></li>`).join('');
  }

  const btn = document.getElementById('orderBtn') as HTMLAnchorElement | null;
  if (btn) {
    const params = new URLSearchParams({ tort: JSON.stringify(config) });
    btn.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/kontakt?${params}`;
  }
}

// Wire up single-select buttons
document.querySelectorAll<HTMLButtonElement>('[data-key]:not([data-key="deko"])').forEach(btn => {
  btn.addEventListener('click', () => {
    const key = btn.dataset.key as keyof Config;
    const val = btn.dataset.value!;

    document.querySelectorAll<HTMLButtonElement>(`[data-key="${key}"]`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    if (key === 'tiers' || key === 'slices') {
      (config[key] as number) = Number(val);
    } else {
      (config[key] as string) = val;
    }
    refresh();
  });
});

// Wire up multi-select deko buttons
document.querySelectorAll<HTMLButtonElement>('[data-key="deko"]').forEach(btn => {
  btn.addEventListener('click', () => {
    const val = btn.dataset.value!;
    btn.classList.toggle('active');
    if (config.deko.includes(val)) {
      config.deko = config.deko.filter(d => d !== val);
    } else {
      config.deko.push(val);
    }
    refresh();
  });
});

// Wire up napis input
document.getElementById('napísInput')?.addEventListener('input', (e) => {
  config.napis = (e.target as HTMLInputElement).value;
  refresh();
});

refresh();
</script>
