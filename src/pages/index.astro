---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Strona główna" page="home">

  <!-- HERO -->
  <section class="hero">
    <h1 class="hero-title">SŁODKO</h1>
    <p class="hero-sub">Kawiarnia pełna słodkich chwil i aromatycznej kawy</p>
    <a href="/kontakt" class="btn-orange">Napisz do nas</a>

    <svg class="hero-illustration" viewBox="0 0 480 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Left croissant -->
      <path d="M42 215 C28 188 34 162 52 150 C70 138 90 144 100 162 C114 186 108 215 90 226 C72 237 56 238 42 215Z"
            stroke="#A3320B" stroke-width="2.5" fill="rgba(163,50,11,0.06)"/>
      <path d="M44 207 C58 197 76 197 88 207" stroke="#A3320B" stroke-width="2" stroke-linecap="round"/>
      <path d="M52 186 C64 177 80 176 92 186" stroke="#A3320B" stroke-width="2" stroke-linecap="round"/>
      <path d="M58 167 C68 160 78 160 88 167" stroke="#A3320B" stroke-width="1.5" stroke-linecap="round"/>

      <!-- Cup steam -->
      <path d="M205 72 C201 55 207 39 203 22" stroke="#A3320B" stroke-width="3" stroke-linecap="round"/>
      <path d="M228 66 C224 49 230 33 226 16" stroke="#A3320B" stroke-width="3" stroke-linecap="round"/>
      <path d="M251 72 C247 55 253 39 249 22" stroke="#A3320B" stroke-width="3" stroke-linecap="round"/>

      <!-- Cup body -->
      <path d="M172 100 L190 200 Q228 220 266 200 L284 100 Z"
            stroke="#A3320B" stroke-width="3.5" fill="rgba(163,50,11,0.07)" stroke-linejoin="round"/>
      <!-- Cup rim -->
      <ellipse cx="228" cy="100" rx="56" ry="11" stroke="#A3320B" stroke-width="3.5" fill="rgba(163,50,11,0.05)"/>
      <!-- Handle -->
      <path d="M284 124 C322 124 326 166 284 166" stroke="#A3320B" stroke-width="3.5" fill="none"/>
      <!-- Saucer -->
      <ellipse cx="228" cy="212" rx="82" ry="17" stroke="#A3320B" stroke-width="3.5" fill="rgba(163,50,11,0.05)"/>
      <!-- Latte heart -->
      <path d="M209 150 C209 141 217 134 228 147 C239 134 247 141 247 150 C247 161 228 177 228 177 C228 177 209 161 209 150Z"
            stroke="#A3320B" stroke-width="2.5" fill="rgba(163,50,11,0.13)"/>

      <!-- Right cake slice -->
      <path d="M350 185 L382 130 L414 185 Z"
            stroke="#A3320B" stroke-width="3" fill="rgba(163,50,11,0.07)"/>
      <path d="M350 185 Q382 202 414 185"
            stroke="#A3320B" stroke-width="3" fill="none"/>
      <path d="M363 167 Q382 176 401 167"
            stroke="#A3320B" stroke-width="2" stroke-linecap="round"/>
      <!-- Cake plate -->
      <ellipse cx="382" cy="192" rx="46" ry="9" stroke="#A3320B" stroke-width="2.5" fill="none"/>
      <!-- Fork next to cake -->
      <line x1="432" y1="162" x2="432" y2="205" stroke="#A3320B" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="425" y1="157" x2="425" y2="172" stroke="#A3320B" stroke-width="2" stroke-linecap="round"/>
      <line x1="432" y1="157" x2="432" y2="172" stroke="#A3320B" stroke-width="2" stroke-linecap="round"/>
      <line x1="439" y1="157" x2="439" y2="172" stroke="#A3320B" stroke-width="2" stroke-linecap="round"/>

      <!-- Decorative sparkles -->
      <path d="M110 88 L112 81 L114 88 L121 90 L114 92 L112 99 L110 92 L103 90 Z"
            stroke="#A3320B" stroke-width="1.5" fill="none" opacity="0.45"/>
      <path d="M358 96 L360 90 L362 96 L368 98 L362 100 L360 106 L358 100 L352 98 Z"
            stroke="#A3320B" stroke-width="1.5" fill="none" opacity="0.45"/>
      <circle cx="72" cy="138" r="5" stroke="#A3320B" stroke-width="2" fill="none" opacity="0.3"/>
      <circle cx="448" cy="230" r="4" stroke="#A3320B" stroke-width="2" fill="none" opacity="0.3"/>
      <circle cx="140" cy="252" r="3" fill="#A3320B" opacity="0.18"/>
      <circle cx="320" cy="58" r="4" fill="#A3320B" opacity="0.14"/>
      <circle cx="460" cy="105" r="3" fill="#A3320B" opacity="0.18"/>
    </svg>
  </section>

  <!-- NASZA HISTORIA -->
  <section class="historia">
    <div class="historia-inner">
      <div>
        <div class="historia-tag">Nasza historia</div>
        <h2 class="historia-quote">Dobra kawa smakuje jeszcze lepiej w dobrym towarzystwie</h2>
        <p class="historia-desc">
          Słodko to miejsce, gdzie każdej filiżance towarzyszy ciepła atmosfera i domowe wypieki.
          Stworzyliśmy przestrzeń, w której czas zwalnia, a każda wizyta zostawia słodki ślad w pamięci.
        </p>
        <a href="/menu" class="btn-orange" style="margin-top: 2rem; display: inline-block;">Zobacz nasze menu</a>
      </div>
      <div class="historia-svg-wrap">
        <svg class="historia-svg" viewBox="0 0 340 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Table -->
          <rect x="40" y="215" width="260" height="14" rx="7" stroke="white" stroke-width="3" fill="rgba(255,255,255,0.1)"/>
          <line x1="70" y1="229" x2="70" y2="278" stroke="white" stroke-width="3" stroke-linecap="round"/>
          <line x1="270" y1="229" x2="270" y2="278" stroke="white" stroke-width="3" stroke-linecap="round"/>
          <!-- Person body -->
          <rect x="122" y="138" width="96" height="80" rx="22" stroke="white" stroke-width="3" fill="rgba(255,255,255,0.08)"/>
          <!-- Head -->
          <circle cx="170" cy="112" r="30" stroke="white" stroke-width="3" fill="rgba(255,255,255,0.08)"/>
          <!-- Arms -->
          <path d="M122 162 C96 162 74 172 68 196" stroke="white" stroke-width="3" stroke-linecap="round" fill="none"/>
          <path d="M218 162 C244 162 266 172 272 196" stroke="white" stroke-width="3" stroke-linecap="round" fill="none"/>
          <!-- Legs -->
          <path d="M148 218 L138 265" stroke="white" stroke-width="3" stroke-linecap="round"/>
          <path d="M192 218 L202 265" stroke="white" stroke-width="3" stroke-linecap="round"/>
          <!-- Coffee cup in left hand -->
          <path d="M68 188 L76 212 Q88 218 100 212 L108 188 Z" stroke="white" stroke-width="2.5" fill="rgba(255,255,255,0.12)"/>
          <ellipse cx="88" cy="188" rx="20" ry="5.5" stroke="white" stroke-width="2.5" fill="none"/>
          <path d="M108 196 C122 196 122 208 108 208" stroke="white" stroke-width="2" fill="none"/>
          <!-- Steam from cup -->
          <path d="M82 182 C80 173 84 164 82 155" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.65"/>
          <path d="M93 179 C91 170 95 161 93 152" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.65"/>
          <!-- Happy face -->
          <path d="M158 115 Q170 124 182 115" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <circle cx="160" cy="106" r="3.5" fill="white"/>
          <circle cx="180" cy="106" r="3.5" fill="white"/>
          <!-- Book/pastry on table -->
          <rect x="200" y="190" width="55" height="35" rx="6" stroke="white" stroke-width="2.5" fill="rgba(255,255,255,0.1)"/>
          <line x1="227" y1="190" x2="227" y2="225" stroke="white" stroke-width="2" opacity="0.6"/>
          <!-- Decorative sparkles -->
          <path d="M292 65 L294 57 L296 65 L304 67 L296 69 L294 77 L292 69 L284 67 Z"
                stroke="white" stroke-width="1.5" fill="none" opacity="0.55"/>
          <circle cx="28" cy="110" r="5" stroke="white" stroke-width="2" fill="none" opacity="0.35"/>
          <circle cx="318" cy="210" r="4" stroke="white" stroke-width="2" fill="none" opacity="0.35"/>
          <circle cx="50" cy="60" r="3" fill="white" opacity="0.25"/>
          <circle cx="310" cy="140" r="3" fill="white" opacity="0.25"/>
        </svg>
      </div>
    </div>
  </section>

</Layout>
